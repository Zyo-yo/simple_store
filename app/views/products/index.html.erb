<h1>Products</h1>

<p>Total products: <%= @products.count %></p>

<% @products.each do |product| %>
  <div>
    <h2><%= product.title %></h2>
    <p>Description: <%= product.description %></p>
    <p>Price: <%= number_to_currency(product.price) %></p>
    <p>Stock quantity: <%= product.stock_quantity %></p>
  </div>
<% end %>